<Window x:Class="UELauncher.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Folders &amp; Unreal Engines"
        Width="640" Height="540"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#0E1117"
        Foreground="#F1F5F9"
        FontFamily="Segoe UI">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Section 1: Project Scan Folders -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="Project Scan Folders" FontSize="15" FontWeight="SemiBold" Foreground="#F1F5F9" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="+ Add Folder" Style="{StaticResource SecondaryButton}" Padding="10,5" Margin="0,0,6,0" Click="AddScanFolder_Click" />
                <Button Content="Remove" Style="{StaticResource DangerButton}" Padding="10,5" Click="RemoveScanFolder_Click" />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Background="#151A23" BorderBrush="#283244" BorderThickness="1" CornerRadius="8" Margin="0,0,0,18">
            <ListBox x:Name="ScanRootsList" Background="Transparent" BorderThickness="0" Foreground="#E2E8F0" Padding="6" FontSize="12.5" />
        </Border>

        <!-- Section 2: Unreal Engine Installations -->
        <DockPanel Grid.Row="2" Margin="0,0,0,8">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="Detected Unreal Engine Installations" FontSize="15" FontWeight="SemiBold" Foreground="#F1F5F9" />
                <TextBlock Text="Auto-detected across C:, D:, E: drives + Epic Registry. Add custom/source engine builds below."
                           FontSize="11.5" Foreground="#64748B" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="+ Add Custom UE" Style="{StaticResource SecondaryButton}" Padding="10,5" Margin="0,0,6,0" Click="AddCustomEngine_Click" />
                <Button Content="Remove Custom" Style="{StaticResource DangerButton}" Padding="10,5" Click="RemoveCustomEngine_Click" />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="3" Background="#151A23" BorderBrush="#283244" BorderThickness="1" CornerRadius="8" Margin="0,0,0,16">
            <ListBox x:Name="EnginesList" Background="Transparent" BorderThickness="0" Foreground="#E2E8F0" Padding="6" FontSize="12.5" />
        </Border>

        <!-- Footer -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Save &amp; Rescan" Style="{StaticResource PrimaryButton}" Padding="18,9" Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
