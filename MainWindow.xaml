<Window x:Class="UELauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:UELauncher.Models"
        Title="UE Forge — Unreal Project Launcher"
        Width="1320" Height="840"
        MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="#0E1117"
        Foreground="#F1F5F9"
        FontFamily="Segoe UI"
        Icon="Assets/app.ico">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================= TOP HEADER BAR ================= -->
        <Border Grid.Row="0" Background="#121721" BorderBrush="#222B3B" BorderThickness="0,0,0,1" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Brand -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,22,0">
                    <Border Width="34" Height="34" CornerRadius="8" Margin="0,0,11,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#2563EB" Offset="0" />
                                <GradientStop Color="#06B6D4" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="U" FontSize="19" FontWeight="Bold" Foreground="#FFFFFF"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="UE Forge" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC" />
                        <TextBlock x:Name="HeaderSummaryText" Text="Scanning projects..." FontSize="11.5" Foreground="#64748B" />
                    </StackPanel>
                </StackPanel>

                <!-- Search + Filters -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Search Box -->
                    <Border Background="#1A212D" BorderBrush="#2B364A" BorderThickness="1" CornerRadius="8"
                            Width="250" Height="34" Margin="0,0,14,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="26" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="&#x1F50D;" FontSize="12" Foreground="#64748B"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <TextBox x:Name="SearchBox" Grid.Column="1"
                                     Background="Transparent" BorderThickness="0" Foreground="#F1F5F9"
                                     CaretBrush="#38BDF8" FontSize="12.5" VerticalContentAlignment="Center"
                                     TextChanged="SearchBox_TextChanged" />
                            <TextBlock x:Name="SearchPlaceholder" Grid.Column="1" Text="Search projects..."
                                       Foreground="#64748B" FontSize="12.5" VerticalAlignment="Center"
                                       IsHitTestVisible="False" />
                            <Button x:Name="ClearSearchBtn" Grid.Column="2" Content="&#x2715;"
                                    Background="Transparent" BorderThickness="0" Foreground="#64748B"
                                    Cursor="Hand" Visibility="Collapsed" Click="ClearSearch_Click" />
                        </Grid>
                    </Border>

                    <!-- Filter Pills -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                        <RadioButton x:Name="FilterAll" Content="All" Style="{StaticResource FilterPill}" IsChecked="True" Checked="Filter_Changed" />
                        <RadioButton x:Name="FilterFav" Content="&#x2605; Favorites" Style="{StaticResource FilterPill}" Checked="Filter_Changed" />
                        <RadioButton x:Name="FilterCpp" Content="C++" Style="{StaticResource FilterPill}" Checked="Filter_Changed" />
                        <RadioButton x:Name="FilterBp" Content="Blueprint" Style="{StaticResource FilterPill}" Checked="Filter_Changed" />
                        <RadioButton x:Name="FilterRunning" Content="Running" Style="{StaticResource FilterPill}" Checked="Filter_Changed" />
                    </StackPanel>

                    <!-- Sort -->
                    <ComboBox x:Name="SortCombo" Style="{StaticResource DarkComboBox}" Width="124" Height="34"
                              SelectionChanged="SortCombo_SelectionChanged">
                        <ComboBoxItem Content="Recent" Tag="Recent" />
                        <ComboBoxItem Content="Name A-Z" Tag="Name" />
                        <ComboBoxItem Content="Engine Ver" Tag="Engine" />
                    </ComboBox>
                </StackPanel>

                <!-- Utility Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Folders &amp; Engines" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="Settings_Click" />
                    <Button Content="&#x21BB; Refresh" Style="{StaticResource SecondaryButton}" Click="Refresh_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= MAIN WORKSPACE (CARDS + INSPECTOR) ================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <!-- LEFT: Project Cards Grid -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Padding="18,16,12,16">
                <Grid>
                    <ItemsControl x:Name="ProjectsItemsControl">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:UnrealProject}">
                                <Border x:Name="CardBorder" Width="244" Height="202" Margin="0,0,14,14"
                                        CornerRadius="12" Background="#161C27" BorderBrush="#263042" BorderThickness="1.2"
                                        Cursor="Hand" MouseLeftButtonDown="ProjectCard_MouseDown">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" BlurRadius="14" ShadowDepth="3" Opacity="0.28" />
                                    </Border.Effect>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="116" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <!-- Cover Banner / Fallback Gradient -->
                                        <Border Grid.Row="0" CornerRadius="11,11,0,0" ClipToBounds="True">
                                            <Grid>
                                                <!-- Gradient fallback -->
                                                <Border>
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                            <GradientStop Color="{Binding FallbackGradientStart}" Offset="0" />
                                                            <GradientStop Color="{Binding FallbackGradientEnd}" Offset="1" />
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                    <TextBlock Text="{Binding Monogram}" FontSize="36" FontWeight="Bold"
                                                               Foreground="#26FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>

                                                <!-- Project Thumbnail (when available) -->
                                                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"
                                                       RenderOptions.BitmapScalingMode="HighQuality" />

                                                <!-- Dark bottom vignette for readability -->
                                                <Border VerticalAlignment="Bottom" Height="42">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                            <GradientStop Color="#00000000" Offset="0" />
                                                            <GradientStop Color="#C8161C27" Offset="1" />
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>

                                                <!-- Top-Left Badges (Engine + C++/BP) -->
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="9,9,0,0">
                                                    <Border Background="#CC0E1117" CornerRadius="5" Padding="7,3" Margin="0,0,5,0">
                                                        <TextBlock Text="{Binding EngineBadgeText}" FontSize="10.5" FontWeight="SemiBold" Foreground="#E2E8F0" />
                                                    </Border>
                                                    <Border CornerRadius="5" Padding="6,3">
                                                        <Border.Background>
                                                            <SolidColorBrush Color="{Binding TypeBadgeColor}" Opacity="0.88" />
                                                        </Border.Background>
                                                        <TextBlock Text="{Binding TypeBadgeText}" FontSize="10.5" FontWeight="Bold" Foreground="#FFFFFF" />
                                                    </Border>
                                                </StackPanel>

                                                <!-- Top-Right Star Favorite -->
                                                <Button Content="{Binding FavoriteGlyph}"
                                                        Tag="{Binding}"
                                                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0"
                                                        Width="28" Height="28" FontSize="15"
                                                        Background="#990E1117" Foreground="#FBBF24" BorderThickness="0"
                                                        Cursor="Hand" Click="ToggleFavorite_Click">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" CornerRadius="14">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </Grid>
                                        </Border>

                                        <!-- Card Footer -->
                                        <Grid Grid.Row="1" Margin="12,8,12,10">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                                       Foreground="#F8FAFC" TextTrimming="CharacterEllipsis" ToolTip="{Binding UProjectPath}" />

                                            <DockPanel Grid.Row="1" VerticalAlignment="Bottom">
                                                <!-- Status Dot + Text -->
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center">
                                                        <Ellipse.Fill>
                                                            <SolidColorBrush Color="{Binding StatusBadgeColor}" />
                                                        </Ellipse.Fill>
                                                    </Ellipse>
                                                    <TextBlock Text="{Binding StatusBadgeText}" FontSize="11.5" Foreground="#94A3B8" VerticalAlignment="Center" />
                                                </StackPanel>

                                                <!-- Inline Quick Play Button -->
                                                <Button Content="&#x25B6;" Tag="{Binding}" ToolTip="Smart Build &amp; Run"
                                                        HorizontalAlignment="Right" Width="32" Height="26"
                                                        Background="#1F2B3E" Foreground="#38BDF8" BorderBrush="#2F415E" BorderThickness="1"
                                                        FontSize="11" Cursor="Hand" Click="CardQuickPlay_Click">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="PlayBd" Background="{TemplateBinding Background}"
                                                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="PlayBd" Property="Background" Value="#2563EB" />
                                                                    <Setter TargetName="PlayBd" Property="BorderBrush" Value="#3B82F6" />
                                                                    <Setter Property="Foreground" Value="#FFFFFF" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </DockPanel>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Empty state -->
                    <StackPanel x:Name="EmptyStatePanel" Visibility="Collapsed"
                                HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,80,0,0">
                        <TextBlock Text="No projects match your filter" FontSize="16" FontWeight="SemiBold"
                                   Foreground="#94A3B8" HorizontalAlignment="Center" />
                        <TextBlock Text="Try clearing the search box or adding a scan folder under Folders &amp; Engines."
                                   FontSize="12.5" Foreground="#64748B" Margin="0,6,0,0" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- RIGHT: Selected Project Inspector Panel -->
            <Border Grid.Column="1" Background="#121721" BorderBrush="#222B3B" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18">
                    <StackPanel x:Name="InspectorPanel" Visibility="Collapsed">
                        <!-- Banner -->
                        <Border Height="148" CornerRadius="10" ClipToBounds="True" Margin="0,0,0,14" BorderBrush="#273245" BorderThickness="1">
                            <Grid>
                                <Border x:Name="InspectorFallbackBg">
                                    <TextBlock x:Name="InspectorMonogram" FontSize="44" FontWeight="Bold"
                                               Foreground="#28FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Image x:Name="InspectorThumb" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                <Border VerticalAlignment="Bottom" Height="56">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#00000000" Offset="0" />
                                            <GradientStop Color="#E6121721" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <StackPanel VerticalAlignment="Bottom" Margin="12,0,12,10">
                                    <TextBlock x:Name="InspectorName" FontSize="19" FontWeight="Bold" Foreground="#F8FAFC" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="InspectorPath" FontSize="11" Foreground="#94A3B8" TextTrimming="CharacterEllipsis" Cursor="Hand"
                                               ToolTip="Click to copy .uproject path" MouseLeftButtonDown="InspectorPath_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Status Callout -->
                        <Border x:Name="InspectorStatusBorder" Background="#19212E" BorderBrush="#2A364B" BorderThickness="1"
                                CornerRadius="8" Padding="12,10" Margin="0,0,0,14">
                            <DockPanel>
                                <Button x:Name="CloseEditorBtn" DockPanel.Dock="Right" Content="Close Editor"
                                        Style="{StaticResource DangerButton}" Padding="9,4" FontSize="11.5"
                                        Visibility="Collapsed" Click="CloseRunningEditor_Click" />
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="InspectorStatusDot" Width="8" Height="8" Margin="0,0,7,0" VerticalAlignment="Center" />
                                        <TextBlock x:Name="InspectorStatusTitle" FontSize="12.5" FontWeight="SemiBold" Foreground="#F1F5F9" />
                                    </StackPanel>
                                    <TextBlock x:Name="InspectorStatusDetail" FontSize="11.5" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,3,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- Primary CTA: Smart Build & Run -->
                        <Button x:Name="PrimaryRunBtn" Style="{StaticResource PrimaryButton}" Height="46" Margin="0,0,0,12"
                                Click="SmartBuildAndRun_Click">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock x:Name="PrimaryRunTitle" Text="&#x25B6;  Build &amp; Run" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" />
                                <TextBlock x:Name="PrimaryRunSub" Text="Auto-compiles if C++ changed, then opens Editor" FontSize="10.5" Foreground="#DBEAFE" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Quick Action Grid -->
                        <UniformGrid Columns="2" Margin="0,0,0,14">
                            <Button x:Name="BtnLaunchOnly" Content="Launch Only" Style="{StaticResource SecondaryButton}" Margin="0,0,4,6" Click="LaunchOnly_Click" />
                            <Button x:Name="BtnBuildEditor" Content="Build Editor" Style="{StaticResource SecondaryButton}" Margin="4,0,0,6" Click="BuildEditor_Click" />
                            <Button x:Name="BtnCleanRebuild" Content="Clean Rebuild" Style="{StaticResource SecondaryButton}" Margin="0,0,4,6" Click="CleanRebuild_Click" />
                            <Button x:Name="BtnRegenSln" Content="Regen .sln" Style="{StaticResource SecondaryButton}" Margin="4,0,0,6" Click="RegenSln_Click" />
                            <Button x:Name="BtnOpenIde" Content="Open in IDE" Style="{StaticResource SecondaryButton}" Margin="0,0,4,6" Click="OpenIde_Click" />
                            <Button x:Name="BtnPackage" Content="Package Win64" Style="{StaticResource SecondaryButton}" Margin="4,0,0,6" Click="PackageWin64_Click" />
                            <Button Content="Open Folder" Style="{StaticResource SecondaryButton}" Margin="0,0,4,0" Click="OpenFolder_Click" />
                            <Button Content="Latest Log" Style="{StaticResource SecondaryButton}" Margin="4,0,0,0" Click="OpenLog_Click" />
                        </UniformGrid>

                        <!-- Engine Override Selector -->
                        <TextBlock Text="UNREAL ENGINE VERSION" FontSize="10.5" FontWeight="Bold" Foreground="#64748B" Margin="0,4,0,6" />
                        <ComboBox x:Name="EngineOverrideCombo" Style="{StaticResource DarkComboBox}" Margin="0,0,0,14"
                                  SelectionChanged="EngineOverrideCombo_SelectionChanged" />

                        <!-- Metadata Details -->
                        <TextBlock Text="PROJECT DETAILS" FontSize="10.5" FontWeight="Bold" Foreground="#64748B" Margin="0,2,0,8" />
                        <Border Background="#161C27" BorderBrush="#242E40" BorderThickness="1" CornerRadius="8" Padding="12,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="104" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Project Type" FontSize="12" Foreground="#64748B" Margin="0,0,0,6" />
                                <TextBlock x:Name="MetaType" Grid.Row="0" Grid.Column="1" FontSize="12" Foreground="#E2E8F0" Margin="0,0,0,6" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Editor Target" FontSize="12" Foreground="#64748B" Margin="0,0,0,6" />
                                <TextBlock x:Name="MetaTarget" Grid.Row="1" Grid.Column="1" FontSize="12" Foreground="#E2E8F0" Margin="0,0,0,6" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="C++ Modules" FontSize="12" Foreground="#64748B" Margin="0,0,0,6" />
                                <TextBlock x:Name="MetaModules" Grid.Row="2" Grid.Column="1" FontSize="12" Foreground="#E2E8F0" TextWrapping="Wrap" Margin="0,0,0,6" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Plugins" FontSize="12" Foreground="#64748B" Margin="0,0,0,6" />
                                <TextBlock x:Name="MetaPlugins" Grid.Row="3" Grid.Column="1" FontSize="12" Foreground="#E2E8F0" Margin="0,0,0,6" />

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Last Updated" FontSize="12" Foreground="#64748B" />
                                <TextBlock x:Name="MetaModified" Grid.Row="4" Grid.Column="1" FontSize="12" Foreground="#E2E8F0" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ================= BOTTOM COLLAPSIBLE BUILD CONSOLE ================= -->
        <Border Grid.Row="2" Background="#0B0E14" BorderBrush="#222B3B" BorderThickness="0,1,0,0">
            <StackPanel>
                <!-- Console Header Strip -->
                <Grid Height="38" Margin="16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="ToggleConsoleBtn" Content="&#x25B2;  Build Console"
                                Background="Transparent" BorderThickness="0" Foreground="#CBD5E1"
                                FontWeight="SemiBold" FontSize="12" Cursor="Hand" Click="ToggleConsole_Click" />
                        <TextBlock x:Name="ConsoleStatusText" Text="Ready" FontSize="12" Foreground="#64748B"
                                   Margin="14,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Live Progress Bar -->
                    <ProgressBar x:Name="BuildProgressBar" Grid.Column="1" Height="6" Margin="20,0"
                                 Background="#1A212D" Foreground="#38BDF8" BorderThickness="0"
                                 Minimum="0" Maximum="100" Value="0" Visibility="Collapsed" />

                    <!-- Right Console Controls -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="ElapsedTimerText" Text="" FontFamily="Consolas" FontSize="12" Foreground="#94A3B8"
                                   Margin="0,0,12,0" VerticalAlignment="Center" />
                        <Button x:Name="CancelBuildBtn" Content="Cancel" Style="{StaticResource DangerButton}"
                                Padding="10,4" FontSize="11.5" Margin="0,0,6,0" Visibility="Collapsed" Click="CancelBuild_Click" />
                        <Button Content="Copy" Style="{StaticResource SecondaryButton}" Padding="9,4" FontSize="11.5" Margin="0,0,6,0" Click="CopyLog_Click" />
                        <Button Content="Clear" Style="{StaticResource SecondaryButton}" Padding="9,4" FontSize="11.5" Click="ClearLog_Click" />
                    </StackPanel>
                </Grid>

                <!-- Expandable Log Output -->
                <RichTextBox x:Name="ConsoleBox" Height="210" Visibility="Collapsed"
                             Background="#090C11" Foreground="#CBD5E1" BorderBrush="#1C2433" BorderThickness="0,1,0,0"
                             FontFamily="Consolas" FontSize="12" IsReadOnly="True"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             Padding="14,8" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
